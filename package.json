{
  "name": "tropicflow",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "check": "node scripts/doctor.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node scripts/serve.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.ts\"",
    "test:e2e:ui": "npm run build && node --test tests/e2e/ui.test.ts",
    "render:wav": "node scripts/render-wav.ts",
    "compare:wav": "node scripts/compare-wav.ts",
    "inspect:ogg": "node scripts/inspect-ogg.ts",
    "golden:update": "node scripts/render-wav.ts --preset default-groove --bars 1 --bit-depth 16 --out tests/golden/default-groove-1bar.wav && node scripts/render-wav.ts --preset chamber-only --bars 1 --bit-depth 16 --out tests/golden/chamber-only-1bar.wav",
    "docs:shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.50.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
